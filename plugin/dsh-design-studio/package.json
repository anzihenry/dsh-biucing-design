{
  "name": "@local/dsh-design-studio",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Design Studio: a left-sidebar design canvas for DeepSeek Harness plus headless-Chrome screenshot/audit tools for visual verification.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "lib/*.js"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node src/test-engine.mjs && node src/test-built.mjs && node src/test-host.mjs",
    "test:host": "node src/test-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0 <0.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "anzihenry"
}
